# Copy this file to `.env` and replace placeholders with your real values.
# NEVER commit your real `.env` file to version control.

# PostgreSQL Connection String (Neon, Supabase, or self-hosted)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Admin Session Tokens (Must be at least 32 characters long in production)
# Generate a secure string: openssl rand -base64 32
JWT_SECRET="replace-with-a-very-strong-and-secure-random-secret-key-at-least-32-chars"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ncss-site"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
